# Server only. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
# Current image model; override with a model enabled for your OpenAI project.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Required for live AI in production. Use a long random passphrase.
STUDIO_ACCESS_CODE=
# Optional durable rate limiting via Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
